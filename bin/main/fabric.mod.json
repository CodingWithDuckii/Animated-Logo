{
  "schemaVersion": 1,
  "id": "animated-mojang-logo",
  "version": "${version}",
  "name": "Animated Logo",
  "authors": [
    "code_itsduckydev"
  ],
  "contributors": [
    "code_itsduckydev"
  ],
  "contact": {
    "homepage": "https://github.com/CodingWithDuckii/Animated-Logo",
    "sources": "https://github.com/CodingWithDuckii/Animated-Logo"
  },
  "license": "Apache-2.0",
  "icon": "assets/animated-mojang-logo/icon.png",
 "environment": "client",
  "entrypoints": {
    "main": [
      "dev.codeitsduckydev.animatedlogo.AnimatedLogo"
    ],
    "modmenu": [
      "dev.codeitsduckydev.animatedlogo.ModMenuIntegration"
    ]
  },
  "mixins": [
    "animated-logo.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*"
