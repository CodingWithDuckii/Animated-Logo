{
  "schema_version": 1,
  "quilt_loader": {
    "group": "dev.codeitsduckydev",
    "id": "animated-mojang-logo",
    "version": "${version}",
    "metadata": {
      "name": "Animated Logo",
      "description": "Replaces the vanilla Minecraft splash screen with an animated logo.",
      "contributors": {
        "code_itsduckydev": "Owner"
      },
      "icon": "assets/animated-mojang-logo/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": "dev.codeitsduckydev.animatedlogo.AnimatedLogo",
      "modmenu": "dev.codeitsduckydev.animatedlogo.ModMenuIntegration"
    },
    "jars": [
      {
        "file": "META-INF/jars/jcodec-0.2.5.jar"
      },
      {
        "file": "META-INF/jars/jcodec-javase-0.2.5.jar"
      }
    ],
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.28.0"
      },
      {
        "id": "minecraft",
        "versions": "${minecraft_version_range}"
      }
    ]
  },
  "mixin": "animated-logo.mixins.json"
}
